<!DOCTYPE html>
<html>
<head>
<HTA:APPLICATION
    ID="bqCompare"
    APPLICATIONNAME="BQ Compare"
    BORDER="thick"
    CAPTION="yes"
    ICON="compare.ico"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SCROLL="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    CONTEXTMENU="yes"
    SELECTION="yes"
    INNERBORDER="no"
    NAVIGABLE="yes"
/>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Сравнение стиха — BibleQuote</title>
<style>
html, body { margin:0; padding:0; font-family: Georgia, "Times New Roman", "PT Serif", serif; font-size: 18px; line-height: 1.6; background:#ffffff; color:#1a1a1a; }
#top { position: sticky; top:0; padding: 6px 10px; background: #eef2f7; border-bottom: 1px solid #b8c2cf; z-index: 10; font-family: "Segoe UI", Tahoma, Arial, sans-serif; font-size: 14px; line-height: 1.3; }
#top .row { display:flex; flex-wrap:wrap; gap:6px; align-items:center; padding: 3px 0; }
#top label { font-weight: bold; margin-right: 2px; }
#top input[type=text] { padding: 3px 6px; font-size: 14px; }
#top select, #top button { padding: 3px 6px; font-size: 14px; font-family: inherit; }
#top button { cursor: pointer; }
#status { margin-left:auto; color:#555; font-style: italic; }
#output { padding: 16px 28px 40px 28px; }
.item { margin: 0 0 18px 0; padding: 0; background: transparent; border: none; }
.item .verse { margin: 0 0 2px 0; }
.item .verse-line { margin: 0 0 4px 0; }
.item .ln { color: #888; font-weight: bold; font-size: 0.92em; margin-right: 6px; font-family: "Segoe UI", Tahoma, sans-serif; }
.item .vn { color: #999; font-weight: bold; font-size: 0.78em; vertical-align: super; margin-right: 4px; font-family: "Segoe UI", Tahoma, sans-serif; }
.item .meta { color: #888; font-size: 12.5px; line-height: 1.3; margin: 2px 0 0 22px; font-family: "Segoe UI", Tahoma, sans-serif; font-style: italic; }
.err { color:#a00; font-family: "Segoe UI", Tahoma, sans-serif; font-size: 14px; }
.placeholder { color:#888; font-style: italic; font-family: "Segoe UI", Tahoma, sans-serif; font-size: 14px; }
#favPanel { display:none; position:fixed; left:0; right:0; top:0; bottom:0; background:rgba(0,0,0,0.35); z-index:100; }
#favBox { position:absolute; top:40px; left:50%; transform:translateX(-50%); background:#fff; width:640px; max-height:85%; overflow:auto; border:1px solid #888; border-radius:4px; padding:10px 14px; }
#favList { columns: 2; column-gap: 20px; font-size: 13px; }
#favList .favrow { display:flex; align-items:center; gap:6px; margin:2px 0; break-inside: avoid; }
#favList .favrow input { margin: 0; }
#favList .favrow .name { flex: 1; }
#favList .favrow .name.excluded { text-decoration: line-through; color:#aaa; }
#favList .favhdr { font-size: 11px; color:#888; display:flex; gap:6px; margin-bottom:4px; padding-bottom:2px; border-bottom:1px solid #ddd; column-span: all; }
#favList .favhdr span.h1 { width:18px; text-align:center; }
#favList .favhdr span.h2 { width:18px; text-align:center; }
.sep { color:#aaa; margin: 0 4px; }
</style>
</head>
<body>
<div id="top">
    <div class="row">
        <label>Эталон:</label>
        <select id="refModule" style="min-width:240px" title="Модуль, по которому строятся списки книг/глав/стихов"></select>
        <label>Книга:</label>
        <select id="book" style="min-width:160px"></select>
        <label>Гл.:</label>
        <select id="chapter" style="min-width:60px"></select>
        <label>Стих:</label>
        <select id="verseFrom" style="min-width:60px"></select>
        <label>—</label>
        <select id="verseTo" style="min-width:60px"></select>
    </div>
    <div class="row">
        <label>Режим:</label>
        <select id="mode">
            <option value="1">1 — Избранные модули</option>
            <option value="2">2 — Все русские</option>
            <option value="3">3 — Все украинские</option>
            <option value="4">4 — Русские + украинские</option>
            <option value="5">5 — Русские + украинские + английские</option>
        </select>
        <label title="Скрыть номера Стронга и разметку"><input type="checkbox" id="clean" checked> Чисто</label>
        <button id="goBtn">Показать</button>
        <button id="favBtn">Избранные…</button>
        <span id="status"></span>
    </div>
</div>

<div id="output">
    <div class="placeholder">
        Выберите эталонный модуль (Библия с полным каноном), затем книгу/главу/стихи и нажмите <b>Показать</b>.<br>
        Для режима 1 сначала нажмите <b>Избранные…</b> и отметьте нужные модули — выбор сохранится на будущее.
    </div>
</div>

<div id="favPanel">
    <div id="favBox">
        <h3 style="margin-top:0">Модули: избранные и исключённые</h3>
        <div style="font-size:12px; color:#555; margin-bottom:8px;">
            <b>★</b> — избранные (режим 1).&nbsp;&nbsp; <b>⊘</b> — исключённые (не появляются ни в одном режиме и не видны в списке эталона).
        </div>
        <div style="margin-bottom:6px;">
            <button id="favAllRu">★ Все русские</button>
            <button id="favAllUk">★ Все украинские</button>
            <button id="favNone">★ Снять все избранные</button>
            <button id="excNone">⊘ Снять все исключения</button>
        </div>
        <div id="favList"></div>
        <div style="text-align:right; margin-top:10px;">
            <button id="favSave">Сохранить</button>
            <button id="favClose">Отмена</button>
        </div>
    </div>
</div>

<script language="JavaScript">
// ============================================================
// BibleQuote verse-compare HTA
// Reads modules from ./Resources/BibleBooks/*
// ============================================================

var fso = new ActiveXObject("Scripting.FileSystemObject");

// --- IE7-compat polyfills for legacy mshta mode ---
if (!Array.prototype.indexOf) {
    Array.prototype.indexOf = function (item, from) {
        var n = this.length >>> 0, i = (from | 0);
        if (i < 0) i = Math.max(0, n + i);
        for (; i < n; i++) if (this[i] === item) return i;
        return -1;
    };
}
function byClass(root, cls) {
    if (root && root.getElementsByClassName) return root.getElementsByClassName(cls);
    var all = (root || document).getElementsByTagName("*"), out = [];
    var rx = new RegExp("(^|\\s)" + cls + "(\\s|$)");
    for (var i = 0; i < all.length; i++) {
        if (rx.test(all[i].className || "")) out.push(all[i]);
    }
    return out;
}

// --- Resolve own directory (strip "file:///" and filename) ---
function getAppDir() {
    var p = unescape(location.pathname);
    if (p.charAt(0) === '/') p = p.substring(1);
    p = p.replace(/\//g, '\\');
    var i = p.lastIndexOf('\\');
    return p.substring(0, i);
}
var APP_DIR = getAppDir();
var MODULES_DIR = APP_DIR + "\\Resources\\BibleBooks";

// --- Detect current Windows user for per-profile state ---
function getCurrentUser() {
    try {
        var net = new ActiveXObject("WScript.Network");
        var u = String(net.UserName || "").replace(/[\\/:*?"<>|]/g, "_");
        if (u) return u;
    } catch (e) {}
    try {
        var sh = new ActiveXObject("WScript.Shell");
        var u2 = String(sh.ExpandEnvironmentStrings("%USERNAME%") || "").replace(/[\\/:*?"<>|]/g, "_");
        if (u2 && u2.indexOf("%") < 0) return u2;
    } catch (e2) {}
    return "_default";
}
var USER_NAME = getCurrentUser();
// Standard (non-portable) BibleQuote 6.5: state lives in %APPDATA%\BibleQuote\
// (already per-Windows-user via %APPDATA%, so no extra user subfolder).
var USER_DIR = (function(){
    try { return new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%APPDATA%") + "\\BibleQuote"; }
    catch(e) { return APP_DIR + "\\BibleQuote_state"; }
})();
var FAV_FILE = USER_DIR + "\\_compare_favorites.txt";
var EXC_FILE = USER_DIR + "\\_compare_excludes.txt";
// SHARED fallbacks point to the same files: no-op fallback, keeps existing read code intact.
var FAV_FILE_SHARED = FAV_FILE;
var EXC_FILE_SHARED = EXC_FILE;

// --- Language classification by folder name (user-editable) ---
var LANG_MAP = {
    // Russian
    "BibleRBO2011":"ru", "Bible_Russian_Agape":"ru",
    "Bible_Russian_CARS":"ru", "Bible_Russian_IBS":"ru", "Bible_Russian_Jubilee":"ru",
    "Bible_Russian_NWTR":"ru", "Bible_Russian_PodStr":"ru",
    "Bible_Russian_RBO_2011":"ru", "Bible_Russian_RSTt":"ru",
    "Bible_Russian_RST_77":"ru", "Bible_Russian_RST_Improved":"ru",
    "Bible_Russian_RST_New":"ru", "Bible_Russian_RST_Strong":"ru",
    "BRMT":"ru", "CARS":"ru", "CAS":"ru",
    "Gospel_Russian_7D":"ru", "GRKWH":"ru",
    "Kassian":"ru", "KNT":"ru", "Kuznetsova":"ru",
    "LOGIC":"ru", "lutkovsky":"ru", "Makarij":"ru",
    "MAP":"ru", "MDR":"ru", "MRT":"ru", "NRT":"ru",
    "NTKul":"ru", "NT_IPB":"ru", "nt_rbc":"ru",
    "NT_Russian_BRUX":"ru", "NT_Russian_BTI":"ru", "NT_Russian_Kassian":"ru",
    "NT_Russian_Kulakov":"ru", "NT_Russian_Live":"ru", "NT_Russian_Living_stream":"ru",
    "NT_Russian_Lutkovsky":"ru", "NT_Russian_Odincov":"ru", "NT_Russian_PBDNSCV":"ru",
    "NT_Russian_Shtainer":"ru", "NT_Russian_SlovoLife":"ru", "NT_Russian_Zhuromsky":"ru",
    "NT_SlovoLife":"ru", "OT_Russian_PAVSK":"ru", "RBS_1824":"ru",
    "RST":"ru", "RST77N":"ru", "RstStrong":"ru", "russian":"ru",
    "vt1":"ru", "WBTC":"ru", "world":"ru",
    // Ukrainian
    "bbl_ZVN_bqt":"uk",
    "Bible_UA_Kulish":"uk", "Bible_Ukraine":"uk",
    "Bible_Ukraine_GYZ":"uk", "Bible_Ukraine_Kulish":"uk",
    "Bible_Ukraine_UBT":"uk", "Bible_Ukraine_UKH":"uk",
    "Gospel_Ukraine_Morach":"uk",
    "NT_Ukraine_TUNT":"uk", "NT_Ukraine_UKDER":"uk", "NT_Ukraine_WBTC":"uk",
    "UBT":"uk", "ukr":"uk", "Ukrwbtc":"uk", "Ukr_Hom":"uk", "UKR_NT_D":"uk"
    // English: (none yet — will auto-detect by folder-name fallback)
};
// Fallback classifier when folder is not in LANG_MAP:
function guessLang(folder) {
    var f = folder.toLowerCase();
    if (/(^|_)(ua|ukr|ukraine|ukr_)/.test(f)) return "uk";
    if (/russian|_ru(_|$)/.test(f)) return "ru";
    if (/english|_en(_|$)|kjv|niv|esv|asv|nasb|web/.test(f)) return "en";
    return "?";
}

// --- Read text file with encoding detection (UTF-8 BOM / UTF-16 LE/BE / windows-1251 / utf-8) ---
function peekBytes(path, n) {
    try {
        var s = new ActiveXObject("ADODB.Stream");
        s.Type = 1; s.Open(); s.LoadFromFile(path);
        if (s.Size === 0) { s.Close(); return []; }
        var raw = s.Read(Math.min(n, s.Size));
        s.Close();
        var arr = new VBArray(raw).toArray();
        var bytes = [];
        for (var i = 0; i < arr.length; i++) bytes.push(arr[i] & 0xFF);
        return bytes;
    } catch (e) { return []; }
}
function readWithCharset(path, charset) {
    try {
        var s = new ActiveXObject("ADODB.Stream");
        s.Type = 2; s.Open(); s.Charset = charset; s.LoadFromFile(path);
        var t = s.ReadText(); s.Close();
        if (t.length > 0 && t.charCodeAt(0) === 0xFEFF) t = t.substring(1);
        return t;
    } catch (e) { return null; }
}
function readText(path) {
    var bytes = peekBytes(path, 3);
    if (bytes.length === 0) return "";
    // BOMs
    if (bytes[0] === 0xEF && bytes[1] === 0xBB && bytes[2] === 0xBF) return readWithCharset(path, "utf-8") || "";
    if (bytes[0] === 0xFF && bytes[1] === 0xFE) return readWithCharset(path, "unicode") || "";
    if (bytes[0] === 0xFE && bytes[1] === 0xFF) return readWithCharset(path, "unicodeFFFE") || "";
    // No BOM: try utf-8, fall back to windows-1251 if it produced replacement chars or invalid sequences
    var asUtf8 = readWithCharset(path, "utf-8");
    if (asUtf8 != null) {
        // U+FFFD (replacement) appears when ADODB encounters illegal UTF-8.
        // Some systems instead silently mangle; detect lone high-bit clusters too.
        if (asUtf8.indexOf("\uFFFD") < 0) return asUtf8;
    }
    var asCp = readWithCharset(path, "windows-1251");
    if (asCp != null) return asCp;
    return asUtf8 || "";
}
function looksMojibake(s) {
    if (!s) return false;
    if (s.indexOf("\uFFFD") >= 0) return true;
    return false;
}

// --- INI parser (flat, allows repeated keys for book entries) ---
// Returns { header: {key:value}, books: [{PathName,FullName,ShortName,ChapterQty}] }
function parseIni(text) {
    var header = {};
    var books = [];
    var cur = null;
    var lines = text.split(/\r?\n/);
    for (var i = 0; i < lines.length; i++) {
        var ln = lines[i];
        // strip BOM if first line
        if (i === 0 && ln.charCodeAt(0) === 0xFEFF) ln = ln.substring(1);
        var t = ln.replace(/^\s+|\s+$/g, "");
        if (!t) continue;
        if (t.indexOf("//") === 0) continue;
        var eq = t.indexOf("=");
        if (eq < 0) continue;
        var key = t.substring(0, eq).replace(/^\s+|\s+$/g, "");
        var val = t.substring(eq + 1).replace(/^\s+|\s+$/g, "");
        if (key === "PathName") {
            if (cur) books.push(cur);
            cur = { PathName: val };
        } else if (cur && (key === "FullName" || key === "ShortName" || key === "ChapterQty")) {
            cur[key] = val;
        } else {
            header[key] = val;
        }
    }
    if (cur) books.push(cur);
    return { header: header, books: books };
}

// --- Enumerate modules ---
var MODULES = []; // [{folder, path, name, shortName, lang, isBible, books, defaultEncoding, chapterSign, verseSign}]
function loadModules() {
    MODULES = [];
    if (!fso.FolderExists(MODULES_DIR)) return;
    var root = fso.GetFolder(MODULES_DIR);
    var enumF = new Enumerator(root.SubFolders);
    for (; !enumF.atEnd(); enumF.moveNext()) {
        var sub = enumF.item();
        var ini = sub.Path + "\\bibleqt.ini";
        if (!fso.FileExists(ini)) continue;
        var txt = readText(ini);
        if (!txt) continue;
        var parsed = parseIni(txt);
        var h = parsed.header;
        var isBible = (String(h["Bible"] || "").toUpperCase().indexOf("Y") === 0);
        if (!isBible) continue; // only Bible modules
        var lang = LANG_MAP[sub.Name];
        if (!lang) lang = guessLang(sub.Name);
        MODULES.push({
            folder: sub.Name,
            path: sub.Path,
            name: (h["BibleName"] || sub.Name).replace(/^\s+|\s+$/g, ""),
            shortName: h["BibleShortName"] || "",
            lang: lang,
            books: parsed.books,
            defaultEncoding: (h["DefaultEncoding"] || "utf-8").toLowerCase(),
            chapterSign: h["ChapterSign"] || "<h4>",
            verseSign: h["VerseSign"] || "<p>"
        });
    }
    // Sort: ru first, then uk, then en, then unknown; inside by name
    var order = {ru:1, uk:2, en:3, "?":9};
    MODULES.sort(function(a,b){
        var da = order[a.lang] || 9, db = order[b.lang] || 9;
        if (da !== db) return da - db;
        return a.name.localeCompare(b.name);
    });
}

// --- Read a book file with declared charset (with CP1251 fallback) ---
function readBookHtml(modulePath, pathName, encoding) {
    var p = modulePath + "\\" + pathName;
    if (!fso.FileExists(p)) {
        // try alternate case (.HTM / .htm)
        var alt = p.replace(/\.htm$/i, ".HTM");
        if (fso.FileExists(alt)) p = alt;
        else {
            alt = p.replace(/\.HTM$/, ".htm");
            if (fso.FileExists(alt)) p = alt;
            else return null;
        }
    }
    var enc = (encoding || "utf-8").toLowerCase();
    if (enc === "utf8") enc = "utf-8";
    if (enc === "cp1251" || enc === "win1251" || enc === "windows1251") enc = "windows-1251";
    var primary = readWithCharset(p, enc);
    if (primary != null && !looksMojibake(primary)) return primary;
    // try alternate encoding
    var alt2 = (enc === "utf-8") ? "windows-1251" : "utf-8";
    var secondary = readWithCharset(p, alt2);
    if (secondary != null && !looksMojibake(secondary)) return secondary;
    return primary || secondary;
}

// --- Reference parsing ---
// Accepts: "Иоан.3:16", "Iв. 3:16-18", "Быт 1:1", "1Кор.13:4-7", "1 Кор. 13:4"
function parseReference(s) {
    s = s.replace(/^\s+|\s+$/g, "");
    if (!s) return null;
    // Find ":" — split book+chapter vs verses
    var m = s.match(/^(.+?)\s*(\d+)\s*:\s*(\d+)\s*(?:[\u2013\u2014\-]\s*(\d+))?\s*$/);
    if (!m) return null;
    var bookPart = m[1].replace(/\s+/g, " ").replace(/\s*\.\s*$/, "").replace(/^\s+|\s+$/g, "");
    return {
        bookRef: bookPart,
        chapter: parseInt(m[2], 10),
        verseFrom: parseInt(m[3], 10),
        verseTo: m[4] ? parseInt(m[4], 10) : parseInt(m[3], 10)
    };
}

function normalizeAbbr(s) {
    // Lowercase, strip dots/spaces/punctuation, then fold cross-script lookalikes so
    // John's abbreviations match across Russian/Ukrainian/Latin variants:
    //   I (lat) ↔ І (ukr) ↔ И (rus)  →  и
    //   i (lat) ↔ і (ukr) ↔ и (rus, after й→и)  →  и
    //   E/Е/Є → е; ЮЯ stay; Ґ/г → г; ї → и; etc.
    var t = String(s).toLowerCase()
        .replace(/[\.\s\-—–_:;,'"‘’“”]/g, "")
        // Latin letters that look like Cyrillic
        .replace(/i/g, "и")
        .replace(/[a]/g, "а")
        .replace(/[e]/g, "е")
        .replace(/[o]/g, "о")
        .replace(/[c]/g, "с")
        .replace(/[p]/g, "р")
        .replace(/[x]/g, "х")
        .replace(/[y]/g, "у")
        .replace(/[k]/g, "к")
        .replace(/[m]/g, "м")
        .replace(/[t]/g, "т")
        .replace(/[h]/g, "н")
        .replace(/[b]/g, "в")
        // Ukrainian/Russian cross-folding
        .replace(/і/g, "и").replace(/ї/g, "и").replace(/й/g, "и").replace(/ы/g, "и")
        .replace(/є/g, "е").replace(/э/g, "е").replace(/ё/g, "е")
        .replace(/ґ/g, "г");
    return t;
}

// --- Find book in module by abbreviation ---
function findBook(module, bookRef) {
    var key = normalizeAbbr(bookRef);
    for (var i = 0; i < module.books.length; i++) {
        var b = module.books[i];
        var full = normalizeAbbr(b.FullName || "");
        if (full === key) return b;
        var sn = b.ShortName || "";
        // ShortName is space-separated list of variants
        var variants = sn.split(/\s+/);
        for (var j = 0; j < variants.length; j++) {
            if (!variants[j]) continue;
            if (normalizeAbbr(variants[j]) === key) return b;
        }
    }
    // Loose match: prefix of FullName
    for (var k = 0; k < module.books.length; k++) {
        var bk = module.books[k];
        var f = normalizeAbbr(bk.FullName || "");
        if (f && f.indexOf(key) === 0) return bk;
    }
    return null;
}

// --- Extract tag name from a sign string like "<H1>" or "<p>" or "<SUP>" ---
function signTag(sign) {
    if (!sign) return "";
    var m = sign.match(/<\s*\/?\s*([a-zA-Z][a-zA-Z0-9]*)/);
    return m ? m[1].toLowerCase() : "";
}

// --- Build chapter-anchor list ---
// We collect h1..h6 anchors (paired tags, with first number inside used as chapter
// number) AND, when ChapterSign is something else (e.g. <hr>, <C>, <V>), void-tag
// anchors where the chapter number is the first integer right after the tag.
// Then we pick a SINGLE source: the level declared by ChapterSign if it has enough
// valid anchors; otherwise the void-tag anchors; otherwise the h-level with the most
// valid anchors. This avoids treating intra-chapter sub-headings as chapter dividers.
function buildChapterAnchors(bookHtml, chTag) {
    var levels = { h1:[], h2:[], h3:[], h4:[], h5:[], h6:[] };
    var reH = /<(h[1-6])\b[^>]*>([\s\S]*?)<\/\1\s*>/gi;
    var mh;
    while ((mh = reH.exec(bookHtml)) !== null) {
        var lev = mh[1].toLowerCase();
        var inner = mh[2].replace(/<[^>]+>/g, " ");
        var nums = inner.match(/\d+/g);
        levels[lev].push({
            pos: mh.index, endPos: reH.lastIndex,
            chapter: nums ? parseInt(nums[0], 10) : null
        });
    }
    // Void-tag anchors for any non-h1-h6 chapter sign (e.g. <hr>, <C>)
    var voidAnchors = [];
    if (chTag && !/^h[1-6]$/.test(chTag)) {
        var reV = new RegExp("<" + chTag + "\\b[^>]*/?\\s*>", "gi");
        var mv;
        while ((mv = reV.exec(bookHtml)) !== null) {
            var endPos = mv.index + mv[0].length;
            var rest = bookHtml.substring(endPos, Math.min(endPos + 300, bookHtml.length));
            var headEnd = rest.search(/<[a-zA-Z\/]/);
            var headText = headEnd >= 0 ? rest.substring(0, headEnd) : rest;
            var nums2 = headText.replace(/<[^>]+>/g, " ").match(/\d+/g);
            voidAnchors.push({
                pos: mv.index, endPos: endPos,
                chapter: nums2 ? parseInt(nums2[0], 10) : null
            });
        }
    }
    function validCount(arr) {
        var c = 0; for (var i = 0; i < arr.length; i++) if (arr[i].chapter != null) c++;
        return c;
    }
    // 1) Honor declared ChapterSign if it's an h-level with enough valid anchors
    if (/^h[1-6]$/.test(chTag) && validCount(levels[chTag]) >= 2) return levels[chTag];
    // 2) Honor declared void ChapterSign if it has enough valid anchors
    if (voidAnchors.length && validCount(voidAnchors) >= 2) return voidAnchors;
    // 3) Fallback: pick the h-level that has the most valid anchors
    var best = null, bestCount = 1;
    var lvls = ["h1","h2","h3","h4","h5","h6"];
    for (var k = 0; k < lvls.length; k++) {
        var c = validCount(levels[lvls[k]]);
        if (c > bestCount) { best = lvls[k]; bestCount = c; }
    }
    if (best) return levels[best];
    // 4) Last resort: any h-level non-empty, or void anchors even if sparse
    for (var k2 = 0; k2 < lvls.length; k2++) if (levels[lvls[k2]].length) return levels[lvls[k2]];
    return voidAnchors;
}

// --- Parse chapter N, return map verseNum -> html text ---
function extractVerses(bookHtml, chapterNum, chapterSign, verseSign) {
    var chTag = signTag(chapterSign) || "h4";
    var vsTag = signTag(verseSign) || "p";

    var anchors = buildChapterAnchors(bookHtml, chTag);
    var startIdx = -1, endIdx = -1;
    for (var i = 0; i < anchors.length; i++) {
        if (anchors[i].chapter === chapterNum) {
            startIdx = anchors[i].endPos;
            // End = next anchor that has a different chapter number
            for (var j = i + 1; j < anchors.length; j++) {
                if (anchors[j].chapter != null && anchors[j].chapter !== chapterNum) {
                    endIdx = anchors[j].pos;
                    break;
                }
            }
            if (endIdx < 0) endIdx = bookHtml.length;
            break;
        }
    }
    if (startIdx < 0) return null;
    var chunk = bookHtml.substring(startIdx, endIdx);
    var result = {};
    if (vsTag === "sup") {
        var reS = /<sup\b[^>]*>\s*(\d+)\s*<\/sup\s*>([\s\S]*?)(?=<sup\b[^>]*>|$)/gi;
        var vm;
        while ((vm = reS.exec(chunk)) !== null) {
            result[parseInt(vm[1], 10)] = vm[2];
        }
    } else {
        // Generic: split chunk at every <vsTag>; classify each block as either a
        // verse-START (begins with a number, optionally wrapped in <b>/<sup>/...) or a
        // CONTINUATION (no leading number). Consecutive blocks that carry the SAME
        // verse number are merged into that verse, and continuations attach to the
        // currently-open verse. This fixes two common patterns of long verses:
        //   A) <p>12 first<p>12 second<p>12 third<p>13 next   (RST_77 Esther 8:12)
        //   B) <p>12 first<p>continuation<p>13 next           (any module)
        var blockRe = new RegExp("<" + vsTag + "\\b[^>]*>", "gi");
        var blocks = [];
        var bm;
        while ((bm = blockRe.exec(chunk)) !== null) {
            blocks.push({ tagStart: bm.index, contentStart: blockRe.lastIndex });
        }
        blocks.push({ tagStart: chunk.length, contentStart: chunk.length });
        var leadNumRe = /^\s*(?:<[^>]+>\s*)*(\d+)\s*([\s\S]*)$/;
        var curNum = null;
        var curParts = [];
        function flush() {
            if (curNum !== null && result[curNum] === undefined) {
                result[curNum] = curParts.join(" ");
            }
        }
        for (var bi = 0; bi < blocks.length - 1; bi++) {
            var bodyText = chunk.substring(blocks[bi].contentStart, blocks[bi+1].tagStart);
            var nm = bodyText.match(leadNumRe);
            if (nm) {
                var num = parseInt(nm[1], 10);
                if (curNum !== null && num === curNum) {
                    curParts.push(nm[2]);
                } else {
                    flush();
                    curNum = num;
                    curParts = [nm[2]];
                }
            } else if (curNum !== null) {
                curParts.push(bodyText);
            }
        }
        flush();
    }
    return result;
}

// --- Clean verse text ---
function cleanVerse(html, clean) {
    var t = html;
    // strip tags (keep line breaks)
    t = t.replace(/<br[^>]*>/gi, " ");
    t = t.replace(/<\/p>/gi, " ");
    t = t.replace(/<[^>]+>/g, "");
    // decode entities minimally
    t = t.replace(/&nbsp;/g, " ").replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#(\d+);/g, function(_,n){ return String.fromCharCode(parseInt(n,10)); });
    if (clean) {
        // strip Strong numbers — sequences of digits >=3 in a row separated by spaces (typical: 2316, 5713)
        t = t.replace(/\s\d{2,5}(\s+\d{1,5})*/g, "");
        // remove stray digits clusters at line start
        t = t.replace(/\s+0\b/g, "");
    }
    // collapse whitespace
    t = t.replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
    return t;
}

// --- Favorites / Excludes persistence ---
function readFolderList(path) {
    if (!fso.FileExists(path)) return {};
    try {
        var s = new ActiveXObject("ADODB.Stream");
        s.Type = 2; s.Open(); s.Charset = "utf-8"; s.LoadFromFile(path);
        var txt = s.ReadText(); s.Close();
        var map = {};
        var lines = txt.split(/\r?\n/);
        for (var i = 0; i < lines.length; i++) {
            var l = lines[i].replace(/^\s+|\s+$/g,"");
            if (l && l.charAt(0) !== "#") map[l] = true;
        }
        return map;
    } catch (e) { return {}; }
}
function ensureUserDir() {
    // Standard variant: only need %APPDATA%\BibleQuote\ to exist.
    if (!fso.FolderExists(USER_DIR)) fso.CreateFolder(USER_DIR);
}
function writeFolderList(path, map, comment) {
    try {
        ensureUserDir();
        var arr = [];
        for (var k in map) if (map[k]) arr.push(k);
        arr.sort();
        var s = new ActiveXObject("ADODB.Stream");
        s.Type = 2; s.Open(); s.Charset = "utf-8";
        s.WriteText("# " + comment + "\r\n" + arr.join("\r\n"));
        s.SaveToFile(path, 2); s.Close();
    } catch (e) {
        alert("Не удалось сохранить список: " + e.message);
    }
}
// Read with fallback: prefer per-user file; if missing, read shared file (migration).
function readFolderListWithFallback(userPath, sharedPath) {
    if (fso.FileExists(userPath)) return readFolderList(userPath);
    if (sharedPath && fso.FileExists(sharedPath)) return readFolderList(sharedPath);
    return {};
}
function readFavorites() { return readFolderListWithFallback(FAV_FILE, FAV_FILE_SHARED); }
function writeFavorites(map) { writeFolderList(FAV_FILE, map, "Избранные модули для СравнениеСтиха.hta — пользователь " + USER_NAME); }
function readExcludes() { return readFolderListWithFallback(EXC_FILE, EXC_FILE_SHARED); }
function writeExcludes(map) { writeFolderList(EXC_FILE, map, "Исключённые модули — пользователь " + USER_NAME); }

// --- Select modules by mode (excluded modules are filtered out everywhere) ---
function selectModules(mode, favMap) {
    var excMap = readExcludes();
    var out = [];
    for (var i = 0; i < MODULES.length; i++) {
        var m = MODULES[i];
        if (excMap[m.folder]) continue; // hard exclude in all modes
        var take = false;
        if (mode === 1) take = !!favMap[m.folder];
        else if (mode === 2) take = (m.lang === "ru");
        else if (mode === 3) take = (m.lang === "uk");
        else if (mode === 4) take = (m.lang === "ru" || m.lang === "uk");
        else if (mode === 5) take = (m.lang === "ru" || m.lang === "uk" || m.lang === "en");
        if (take) out.push(m);
    }
    return out;
}

// --- Build output ---
function htmlEscape(s) {
    return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

function show() {
    var status = document.getElementById("status");
    var output = document.getElementById("output");
    var mode = parseInt(document.getElementById("mode").value, 10);
    var clean = document.getElementById("clean").checked;

    var refMod = currentRefModule();
    var bookIdx = parseInt(document.getElementById("book").value, 10);
    var chapter = parseInt(document.getElementById("chapter").value, 10);
    var verseFrom = parseInt(document.getElementById("verseFrom").value, 10);
    var verseTo = parseInt(document.getElementById("verseTo").value, 10);
    if (!refMod || isNaN(bookIdx) || isNaN(chapter) || isNaN(verseFrom)) {
        output.innerHTML = '<div class="err">Выберите модуль/книгу/главу/стих.</div>';
        return;
    }
    if (isNaN(verseTo) || verseTo < verseFrom) verseTo = verseFrom;
    if (verseTo - verseFrom > 50) verseTo = verseFrom + 50; // safety

    var refBook = refMod.books[bookIdx];
    var ref = {
        bookFullName: refBook.FullName || "",
        bookShortNames: refBook.ShortName || "",
        chapter: chapter,
        verseFrom: verseFrom,
        verseTo: verseTo
    };

    var favMap = (mode === 1) ? readFavorites() : {};
    var selected = selectModules(mode, favMap);
    if (selected.length === 0) {
        if (mode === 1) {
            output.innerHTML = '<div class="err">Список избранных модулей пуст. Нажмите <b>Избранные…</b> и отметьте модули.</div>';
        } else {
            output.innerHTML = '<div class="err">Для выбранного режима нет подходящих модулей.</div>';
        }
        return;
    }
    status.innerText = "Обработка " + selected.length + " модулей…";
    saveState();
    window.setTimeout(function(){ renderCompare(selected, ref, clean); }, 15);
}

// Find book in a module by trying all reference name variants.
// Two-pass: FIRST match against target FullName (most reliable), only then fall back
// to target ShortName. This protects against modules with broken/mis-shifted ShortName
// fields (e.g. an "Acts" book that lists "John" among its short names).
function findBookByRef(module, ref) {
    var refKeys = [];
    var pushKey = function (raw) {
        var k = normalizeAbbr(raw || "");
        if (k && refKeys.indexOf(k) < 0) refKeys.push(k);
    };
    pushKey(ref.bookFullName);
    var snVars = String(ref.bookShortNames || "").split(/\s+/);
    for (var i = 0; i < snVars.length; i++) pushKey(snVars[i]);
    if (refKeys.length === 0) return null;

    // Pass 1: any ref key against target FullName
    for (var b1 = 0; b1 < module.books.length; b1++) {
        var fn = normalizeAbbr(module.books[b1].FullName || "");
        if (fn && refKeys.indexOf(fn) >= 0) return module.books[b1];
    }
    // Pass 2: any ref key against target ShortName variants
    for (var b2 = 0; b2 < module.books.length; b2++) {
        var sn = String(module.books[b2].ShortName || "").split(/\s+/);
        for (var l = 0; l < sn.length; l++) {
            var k = normalizeAbbr(sn[l]);
            if (k && refKeys.indexOf(k) >= 0) return module.books[b2];
        }
    }
    return null;
}
function renderCompare(selected, ref, clean) {
    var buf = [];
    var shown = 0, missed = 0, missedNames = [];
    for (var i = 0; i < selected.length; i++) {
        var mod = selected[i];
        var book = findBookByRef(mod, ref);
        if (!book) { missed++; missedNames.push(mod.name + " (нет книги)"); continue; }
        var html = readBookHtml(mod.path, book.PathName, mod.defaultEncoding);
        if (!html) { missed++; missedNames.push(mod.name + " (нет файла)"); continue; }
        var verses = extractVerses(html, ref.chapter, mod.chapterSign, mod.verseSign);
        if (!verses) { missed++; missedNames.push(mod.name + " (нет главы " + ref.chapter + ")"); continue; }
        var rows = [];
        for (var v = ref.verseFrom; v <= ref.verseTo; v++) {
            if (verses[v] != null) {
                rows.push('<span class="vn">' + v + '</span>' + htmlEscape(cleanVerse(verses[v], clean)));
            }
        }
        if (rows.length === 0) { missed++; missedNames.push(mod.name + " (стихи не найдены)"); continue; }
        shown++;
        var langLabel = mod.lang === "ru" ? "рус" : mod.lang === "uk" ? "укр" : mod.lang === "en" ? "англ" : "?";
        var refLabel = htmlEscape(book.FullName || ref.bookFullName) + " " + ref.chapter + ":" +
                       (ref.verseFrom === ref.verseTo ? ref.verseFrom : ref.verseFrom + "-" + ref.verseTo);
        var meta = htmlEscape(mod.name) + (mod.shortName ? " · " + htmlEscape(mod.shortName) : "") +
                   " · " + langLabel + " · " + refLabel;
        // First verse line gets the list number; subsequent verses keep alignment via empty span
        var lines = [];
        for (var r = 0; r < rows.length; r++) {
            if (r === 0) {
                lines.push('<p class="verse-line"><span class="ln">' + shown + '.</span>' + rows[r] + '</p>');
            } else {
                lines.push('<p class="verse-line" style="margin-left:22px">' + rows[r] + '</p>');
            }
        }
        buf.push('<div class="item">' + lines.join("") + '<div class="meta">' + meta + '</div></div>');
    }
    var statusTxt = "Показано: " + shown + (missed ? ", пропущено: " + missed : "");
    // shown was used as a running counter for list numbers; statusTxt above keeps its final value
    if (missed > 0 && missedNames.length) {
        statusTxt += " — " + missedNames.slice(0, 3).join("; ") + (missedNames.length > 3 ? "…" : "");
    }
    var statusEl = document.getElementById("status");
    statusEl.innerText = statusTxt;
    // Store full miss list for click-to-expand
    statusEl._missedFull = missedNames;
    statusEl.title = missedNames.length ? "Нажмите, чтобы увидеть полный список пропущенных" : "";
    statusEl.style.cursor = missedNames.length ? "pointer" : "default";
    statusEl.onclick = missedNames.length ? function () {
        var out = document.getElementById("output");
        var existing = document.getElementById("missedBlock");
        if (existing) { existing.parentNode.removeChild(existing); return; }
        var lis = "";
        for (var k = 0; k < missedNames.length; k++) {
            lis += '<li>' + htmlEscape(missedNames[k]) + '</li>';
        }
        var div = document.createElement("div");
        div.id = "missedBlock";
        div.className = "err";
        div.style.cssText = "font-family:Segoe UI,Tahoma,sans-serif;font-size:13px;line-height:1.5;margin-bottom:18px;padding-bottom:10px;border-bottom:1px solid #ccc;";
        div.innerHTML = '<b>Пропущено ' + missedNames.length + ' модулей:</b><ol>' + lis + '</ol>';
        out.insertBefore(div, out.firstChild);
    } : null;
    if (shown === 0) {
        document.getElementById("output").innerHTML = '<div class="err">Стих не найден ни в одном из выбранных модулей.<br>' + htmlEscape(missedNames.join("; ")) + '</div>';
    } else {
        document.getElementById("output").innerHTML = buf.join("");
    }
}

// --- Favorites/Excludes panel ---
function openFav() {
    var panel = document.getElementById("favPanel");
    var list = document.getElementById("favList");
    var favMap = readFavorites();
    var excMap = readExcludes();
    var html = [];
    for (var i = 0; i < MODULES.length; i++) {
        var m = MODULES[i];
        var fav = favMap[m.folder] ? 'checked="checked"' : '';
        var exc = excMap[m.folder] ? 'checked="checked"' : '';
        var nameClass = excMap[m.folder] ? "name excluded" : "name";
        var langLabel = m.lang === "ru" ? "рус" : m.lang === "uk" ? "укр" : m.lang === "en" ? "англ" : "?";
        html.push(
            '<label class="favrow" title="' + htmlEscape(m.folder) + '">' +
                '<input type="checkbox" class="favchk" data-lang="' + m.lang + '" value="' + htmlEscape(m.folder) + '" ' + fav + ' title="Избранный модуль (режим 1)">' +
                '<input type="checkbox" class="excchk" data-lang="' + m.lang + '" value="' + htmlEscape(m.folder) + '" ' + exc + ' title="Исключить из всех режимов">' +
                '<span class="' + nameClass + '"><span style="color:#888">[' + langLabel + ']</span> ' + htmlEscape(m.name) + '</span>' +
            '</label>'
        );
    }
    list.innerHTML = html.join("");
    // Visual feedback: strike-through name when exclude toggled
    var excBoxes = byClass(list, "excchk");
    for (var k = 0; k < excBoxes.length; k++) {
        excBoxes[k].onclick = function () {
            var nameSpan = byClass(this.parentNode, "name")[0];
            if (nameSpan) nameSpan.className = this.checked ? "name excluded" : "name";
        };
    }
    panel.style.display = "block";
}
function closeFav() { document.getElementById("favPanel").style.display = "none"; }
function saveFav() {
    var list = document.getElementById("favList");
    var favBoxes = byClass(list, "favchk");
    var excBoxes = byClass(list, "excchk");
    var favMap = {}, excMap = {};
    for (var i = 0; i < favBoxes.length; i++) if (favBoxes[i].checked) favMap[favBoxes[i].value] = true;
    for (var j = 0; j < excBoxes.length; j++) if (excBoxes[j].checked) excMap[excBoxes[j].value] = true;
    writeFavorites(favMap);
    writeExcludes(excMap);
    closeFav();
    // Refresh dropdowns since excluded reference modules might disappear
    var prevRef = document.getElementById("refModule").value;
    populateRefModule();
    setSelectValue("refModule", prevRef);
    populateBooks(); populateChapters(); populateVerses();
    var fc = 0, ec = 0;
    for (var a in favMap) if (favMap[a]) fc++;
    for (var b in excMap) if (excMap[b]) ec++;
    document.getElementById("status").innerText = "Сохранено: ★ избранных " + fc + ", ⊘ исключённых " + ec + ".";
}
function favBulk(lang, state) {
    var boxes = byClass(document.getElementById("favList"), "favchk");
    for (var i = 0; i < boxes.length; i++) {
        if (lang === null || boxes[i].getAttribute("data-lang") === lang) boxes[i].checked = state;
    }
}
function excBulk(state) {
    var boxes = byClass(document.getElementById("favList"), "excchk");
    for (var i = 0; i < boxes.length; i++) boxes[i].checked = state;
    // Update strike-through visuals
    for (var j = 0; j < boxes.length; j++) {
        var nameSpan = byClass(boxes[j].parentNode, "name")[0];
        if (nameSpan) nameSpan.className = state ? "name excluded" : "name";
    }
}

// --- Reference module / book / chapter / verse dropdowns ---
function currentRefModule() {
    var sel = document.getElementById("refModule");
    if (!sel || sel.selectedIndex < 0) return null;
    var folder = sel.value;
    for (var i = 0; i < MODULES.length; i++) if (MODULES[i].folder === folder) return MODULES[i];
    return null;
}
function populateRefModule() {
    var sel = document.getElementById("refModule");
    sel.innerHTML = "";
    var excMap = readExcludes();
    // Prefer modules with most books (likely full Bible); skip excluded
    var sorted = MODULES.slice().sort(function(a,b){
        var da = b.books.length - a.books.length;
        if (da !== 0) return da;
        return a.name.localeCompare(b.name);
    });
    for (var i = 0; i < sorted.length; i++) {
        var m = sorted[i];
        if (excMap[m.folder]) continue;
        var langLabel = m.lang === "ru" ? "рус" : m.lang === "uk" ? "укр" : m.lang === "en" ? "англ" : "?";
        var opt = document.createElement("option");
        opt.value = m.folder;
        opt.text = "[" + langLabel + "] " + m.name + " (" + m.books.length + " кн.)";
        sel.appendChild(opt);
    }
}
function populateBooks() {
    var mod = currentRefModule();
    var sel = document.getElementById("book");
    sel.innerHTML = "";
    if (!mod) return;
    for (var i = 0; i < mod.books.length; i++) {
        var b = mod.books[i];
        var opt = document.createElement("option");
        opt.value = i;
        opt.text = b.FullName || ("книга " + (i+1));
        sel.appendChild(opt);
    }
}
function populateChapters() {
    var mod = currentRefModule();
    var bookIdx = parseInt(document.getElementById("book").value, 10);
    var sel = document.getElementById("chapter");
    sel.innerHTML = "";
    if (!mod || isNaN(bookIdx)) return;
    var b = mod.books[bookIdx];
    var n = parseInt(b.ChapterQty, 10) || 1;
    for (var i = 1; i <= n; i++) {
        var opt = document.createElement("option");
        opt.value = i; opt.text = i;
        sel.appendChild(opt);
    }
}
function populateVerses() {
    var mod = currentRefModule();
    var bookIdx = parseInt(document.getElementById("book").value, 10);
    var ch = parseInt(document.getElementById("chapter").value, 10);
    var selFrom = document.getElementById("verseFrom");
    var selTo = document.getElementById("verseTo");
    selFrom.innerHTML = ""; selTo.innerHTML = "";
    if (!mod || isNaN(bookIdx) || isNaN(ch)) return;
    var b = mod.books[bookIdx];
    var html = readBookHtml(mod.path, b.PathName, mod.defaultEncoding);
    var maxV = 0;
    if (html) {
        var vs = extractVerses(html, ch, mod.chapterSign, mod.verseSign);
        if (vs) {
            for (var k in vs) { var n = parseInt(k,10); if (n > maxV) maxV = n; }
        }
    }
    if (maxV === 0) maxV = 200; // fallback (chapter not parsed in this module)
    for (var i = 1; i <= maxV; i++) {
        var o1 = document.createElement("option"); o1.value = i; o1.text = i; selFrom.appendChild(o1);
        var o2 = document.createElement("option"); o2.value = i; o2.text = i; selTo.appendChild(o2);
    }
}
function syncVerseTo() {
    var f = parseInt(document.getElementById("verseFrom").value, 10);
    var selTo = document.getElementById("verseTo");
    if (isNaN(f)) return;
    if (parseInt(selTo.value, 10) < f) selTo.value = f;
}

// --- State persistence (last selection) ---
var STATE_FILE = USER_DIR + "\\_compare_state.txt";
var STATE_FILE_SHARED = STATE_FILE; // no-op fallback for Standard variant
function saveState() {
    try {
        ensureUserDir();
        var data = [
            "refModule=" + document.getElementById("refModule").value,
            "book=" + document.getElementById("book").value,
            "chapter=" + document.getElementById("chapter").value,
            "verseFrom=" + document.getElementById("verseFrom").value,
            "verseTo=" + document.getElementById("verseTo").value,
            "mode=" + document.getElementById("mode").value,
            "clean=" + (document.getElementById("clean").checked ? "1" : "0")
        ].join("\r\n");
        var s = new ActiveXObject("ADODB.Stream");
        s.Type = 2; s.Open(); s.Charset = "utf-8"; s.WriteText(data);
        s.SaveToFile(STATE_FILE, 2); s.Close();
    } catch (e) {}
}
function loadState() {
    var path = fso.FileExists(STATE_FILE) ? STATE_FILE
              : (fso.FileExists(STATE_FILE_SHARED) ? STATE_FILE_SHARED : null);
    if (!path) return {};
    var t = readWithCharset(path, "utf-8") || "";
    var lines = t.split(/\r?\n/);
    var st = {};
    for (var i = 0; i < lines.length; i++) {
        var eq = lines[i].indexOf("=");
        if (eq > 0) st[lines[i].substring(0, eq)] = lines[i].substring(eq + 1);
    }
    return st;
}
function setSelectValue(id, val) {
    if (val == null || val === "") return;
    var s = document.getElementById(id);
    for (var i = 0; i < s.options.length; i++) if (s.options[i].value === val) { s.selectedIndex = i; return; }
}

// --- Init ---
window.onload = function () {
    try {
        loadModules();
    } catch (e) {
        document.getElementById("output").innerHTML = '<div class="err">Ошибка загрузки модулей: ' + htmlEscape(e.message) + '<br>Убедитесь, что .hta лежит в корне BibleQuote6.5mod83 рядом с папкой Resources.</div>';
        return;
    }
    document.getElementById("status").innerText = "Загружено модулей: " + MODULES.length;
    try { window.resizeTo(1200, 850); } catch (e) {}

    populateRefModule();
    var st = loadState();
    if (st.refModule) setSelectValue("refModule", st.refModule);
    populateBooks();
    if (st.book) setSelectValue("book", st.book);
    populateChapters();
    if (st.chapter) setSelectValue("chapter", st.chapter);
    populateVerses();
    if (st.verseFrom) setSelectValue("verseFrom", st.verseFrom);
    if (st.verseTo) setSelectValue("verseTo", st.verseTo);
    if (st.mode) setSelectValue("mode", st.mode);
    if (st.clean === "0") document.getElementById("clean").checked = false;

    document.getElementById("refModule").onchange = function(){ populateBooks(); populateChapters(); populateVerses(); };
    document.getElementById("book").onchange = function(){ populateChapters(); populateVerses(); };
    document.getElementById("chapter").onchange = function(){ populateVerses(); };
    document.getElementById("verseFrom").onchange = syncVerseTo;

    document.getElementById("goBtn").onclick = show;
    document.getElementById("favBtn").onclick = openFav;
    document.getElementById("favClose").onclick = closeFav;
    document.getElementById("favSave").onclick = saveFav;
    document.getElementById("favAllRu").onclick = function(){ favBulk("ru", true); };
    document.getElementById("favAllUk").onclick = function(){ favBulk("uk", true); };
    document.getElementById("favNone").onclick  = function(){ favBulk(null, false); };
    document.getElementById("excNone").onclick  = function(){ excBulk(false); };
};
</script>
</body>
</html>
